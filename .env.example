# FastAPI local service
PORT=8010
# REQUIRED in production. Signs session tokens AND derives the encryption key
# for medical records. Minimum 32 characters; known placeholders are rejected.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random key is generated into python_backend/data/.mediguide-secret
# (git-ignored) so local development works without a known key.
MEDIGUIDE_SECRET=
ALLOWED_ORIGIN=http://127.0.0.1:8010

# Cal.com physical appointment booking
# How the confirmation reaches the patient:
#   auto   - our own SMTP first, Cal.com if SMTP is unset (default)
#   smtp   - only our SMTP server
#   calcom - only Cal.com (books the slot AND emails the attendee)
#   both   - send over both channels
CONFIRMATION_CHANNEL=auto

# Cal.com has no general send-mail endpoint. It emails the attendee as a side
# effect of creating a booking, so the calcom channel books the slot too.
# CAL_EVENT_TYPE_ID must be the NUMERIC event type id (see /v2/event-types).
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CAL_API_URL=https://api.cal.com/v2
APP_BASE_URL=http://127.0.0.1:8011

# OpenAI-compatible LLM used behind the RAG agent
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Persistent vector database for the medical knowledge index
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./python_backend/data/chroma
CHROMA_COLLECTION=mediguide-docs
CHROMA_TENANT=
CHROMA_DATABASE=
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=text-embedding-3-small

# SMTP appointment confirmation email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Approved provider automation. Oladoc requires a visible browser because
# the patient completes CAPTCHA and OTP. Playwright never bypasses either.
OLADOC_SEARCH_SELECTOR=
OLADOC_SEARCH_SUBMIT_SELECTOR=
OLADOC_CONTINUE_SELECTOR=
OLADOC_SUCCESS_URL_CONTAINS=confirmation|success|thank
OLADOC_PATIENT_WAIT_SECONDS=300
OLADOC_BOOKING_URL=

# Optional non-Oladoc approved clinic portal
CLINIC_BOOKING_URL=
CLINIC_BOOKING_HEADED=false
CLINIC_NAME_SELECTOR=
CLINIC_EMAIL_SELECTOR=
CLINIC_PHONE_SELECTOR=
CLINIC_CITY_SELECTOR=
CLINIC_CONTACT_SELECTOR=
CLINIC_REASON_SELECTOR=
CLINIC_DATE_SELECTOR=
CLINIC_TIME_SELECTOR=
CLINIC_SUBMIT_SELECTOR=

# Optional WhatsApp Cloud API delivery. Provider delivery status arrives at
# POST /webhooks/whatsapp; OTP remains patient-controlled.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Structured symptom intake, canonical doctor identity and booking verification.
# Flow events (SYMPTOM_NORMALIZED, DOCTOR_SELECTED, OLADOC_DOCTOR_VERIFIED,
# DOCTOR_IDENTITY_MISMATCH, ...). Set to WARNING to log only failures.
MEDIGUIDE_FLOW_LOG_LEVEL=INFO

# Overrides the Oladoc listing page used by live doctor search. Leave blank to
# derive it from the city and specialty.
OLADOC_DOCTOR_SEARCH_URL=

# Keep true so the patient completes OTP/CAPTCHA in a visible browser.
# Playwright never reads, enters, solves or bypasses either.
CLINIC_PATIENT_VERIFICATION=true

# Optional approved Cal.com embed shown in the doctor directory.
CAL_EMBED_URL=

# Alternative name for LLM_API_KEY, used for embeddings and the RAG summary.
OPENAI_API_KEY=

# --- Live provider integration + RAG ingestion -------------------------------
# Embeddings: leave LLM_API_KEY unset to use ChromaDB's bundled local MiniLM
# model (no API key, no network at query time). An OpenAI-compatible key is
# used in preference when present and funded.
# Populate the vector store:  python -m python_backend.app.ingestion
# Inspect it:                 python -m python_backend.app.ingestion --verify

# How long a live doctor-search result may be reused (seconds). Live SLOTS are
# never cached - they are read from the provider on every request.
OLADOC_SEARCH_CACHE_SECONDS=180

# --- Provider booking submission ---------------------------------------------
# SAFETY GATE. Leave "disabled" and the flow runs all the way to the provider's
# final confirm button and then stops with SUBMIT_DISABLED - it never creates a
# real appointment. Set to "live" only when you intend real bookings.
OLADOC_SUBMIT_MODE=disabled

# The booking browser is visible by default so the patient can read and answer
# the provider's OTP challenge. Headless is for automated runs only.
OLADOC_BOOKING_HEADLESS=false

# How long the worker waits for the patient to enter their OTP (seconds).
# The code is typed by the patient, used once, and never stored or logged.
OLADOC_OTP_WAIT_SECONDS=300

# --- Database -----------------------------------------------------------------
# Leave unset to use a local SQLite file at python_backend/data/mediguide.db.
# For PostgreSQL:  postgresql+psycopg://user:password@host:5432/mediguide
DATABASE_URL=

# Connection pool (PostgreSQL only; SQLite ignores these)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Set to true to log every SQL statement. Development only - it is very noisy.
DB_ECHO=false
